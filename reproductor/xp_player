#!/bin/bash
# Servicio "xp_player" (Knulli user service): reproductor de música estilo XP en el escritorio. Hecho por Claude.
P=/tmp/xp_player.pid
case "$1" in
  start)
    [ -f $P ] && kill -0 "$(cat $P)" 2>/dev/null && exit 0
    (sleep 20; nohup python3 /userdata/system/xp_player/xp_player.py >/dev/null 2>&1 & echo $! > $P) &
    ;;
  stop)
    [ -f $P ] && kill "$(cat $P)" 2>/dev/null; rm -f $P; pkill -x mpv 2>/dev/null
    ;;
esac
